NWIS_DB_PASSWORD=replace-with-a-long-local-password
NWIS_VIEWER_TOKEN=replace-with-a-unique-long-viewer-token
NWIS_ENGINEER_TOKEN=replace-with-a-unique-long-engineer-token
NWIS_REVIEWER_TOKEN=replace-with-a-unique-long-reviewer-token
NWIS_ADMIN_TOKEN=replace-with-a-unique-long-admin-token

# Optional overrides
NWIS_API_PORT=8000
NWIS_WEB_PORT=3000
NWIS_ENVIRONMENT=local
NWIS_DB_PORT=5432
# No provider credential is needed for the disclosed local baseline.
NWIS_EXTRACTION_PROVIDER=local_rules
# Set these only for a provider-approved public/synthetic report workflow.
NWIS_LLM_BASE_URL=https://api.openai.com/v1
NWIS_LLM_MODEL=
NWIS_LLM_API_KEY=
